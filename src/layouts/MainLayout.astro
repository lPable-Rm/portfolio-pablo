---
// El layout centraliza todo lo comun a la pagina:
// metadatos, estilos globales, header fijo y el contenedor principal.
import Analytics from "@vercel/analytics/astro";
import Header from "../components/Header";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Pablo Ramos | Desarrollador Fullstack en Las palmas",
  description = "Pablo Ramos, desarrollador creativo y programador fullstack en Las Palmas, especializado en frontend, backend, datos e inteligencia artificial.",
} = Astro.props;

const canonicalUrl = "https://www.pramos.dev/";

const socialImageUrl = "https://www.pramos.dev/assets/og-image.jpg";
const socialDescription =
  "Pablo Ramos, desarrollador fullstack en Las Palmas especializado en frontend, backend, datos e IA.";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${canonicalUrl}#website`,
      url: canonicalUrl,
      name: "Pablo Ramos Portfolio",
      description,
      inLanguage: "es",
    },
    {
      "@type": "ProfilePage",
      "@id": `${canonicalUrl}#profile`,
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: {
        "@id": `${canonicalUrl}#website`,
      },
      about: {
        "@id": `${canonicalUrl}#person`,
      },
      inLanguage: "es",
    },
    {
      "@type": "Person",
      "@id": `${canonicalUrl}#person`,
      name: "Pablo Ramos",
      url: canonicalUrl,
      image: socialImageUrl,
      jobTitle: "Desarrollador Fullstack",
      description,
      email: "mailto:contacto@pramos.dev",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Las Palmas",
        addressRegion: "Canarias",
        addressCountry: "ES",
      },
      knowsAbout: [
        "Frontend",
        "Backend",
        "Datos",
        "Inteligencia artificial",
        "Astro",
        "React",
        "TypeScript",
        "Python",
        "FastAPI",
        "PostgreSQL",
      ],
      sameAs: ["https://github.com/lPable-Rm", "https://www.instagram.com/lpablo.ramos/"],
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <!-- Metadatos basicos para que la pagina sea responsive, indexable y tenga favicon. -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- URL principal que deben indexar los buscadores. -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Metadatos sociales: mejoran la vista previa al compartir la web. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pablo Ramos Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Pablo Ramos, desarrollador fullstack en Las Palmas" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Pablo Ramos, desarrollador fullstack en Las Palmas" />

    <!-- Datos estructurados: refuerzan la entidad Pablo Ramos para buscadores e IA. -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <!-- Analitica invisible de Vercel: mide visitas sin modificar la interfaz. -->
    <Analytics />
  </head>
  <body>
    <!-- Enlace de accesibilidad: permite saltar el menu usando teclado. -->
    <a class="skip-link" href="#main-content">Saltar al contenido</a>

    <!-- Header React porque necesitara estado activo y menu movil. -->
    <Header client:load />

    <!-- Aqui Astro inyecta las secciones de cada pagina. -->
    <main id="main-content" class="site-main">
      <slot />
    </main>
  </body>
</html>
