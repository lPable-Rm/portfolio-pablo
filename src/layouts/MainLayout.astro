---
// El layout centraliza todo lo comun a la pagina:
// metadatos, estilos globales, header fijo y el contenedor principal.
import Analytics from "@vercel/analytics/astro";
import Header from "../components/Header";
import { projects } from "../data/projects";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Pablo Ramos | Desarrollador Fullstack en Las Palmas",
  description = "Pablo Ramos, desarrollador creativo y programador fullstack en Las Palmas, especializado en frontend, backend, datos e inteligencia artificial.",
} = Astro.props;

const canonicalUrl = "https://www.pramos.dev/";

const socialImageUrl = "https://www.pramos.dev/assets/og-image.jpg";
const socialDescription =
  "Pablo Ramos, desarrollador fullstack en Las Palmas especializado en frontend, backend, datos e IA.";

const personId = `${canonicalUrl}#person`;
const profileId = `${canonicalUrl}#profile`;
const websiteId = `${canonicalUrl}#website`;

const absoluteUrl = (url: string) =>
  url.startsWith("http") ? url : new URL(url, canonicalUrl).toString();

const projectSchemaDetails: Record<
  string,
  {
    type: string | string[];
    programmingLanguage?: string[];
    runtimePlatform?: string;
  }
> = {
  "restaurant-ai": {
    type: ["SoftwareSourceCode", "CreativeWork"],
    programmingLanguage: ["Python", "SQL", "JavaScript", "HTML", "CSS"],
    runtimePlatform: "FastAPI",
  },
  "portfolio-8bit": {
    type: ["SoftwareSourceCode", "CreativeWork"],
    programmingLanguage: ["TypeScript", "JavaScript", "HTML", "CSS"],
    runtimePlatform: "Astro",
  },
  "data-analyst": {
    type: "CreativeWork",
    programmingLanguage: ["Python", "SQL"],
  },
};

const projectEntities = projects.map((project) => {
  const details = projectSchemaDetails[project.id] ?? { type: "CreativeWork" };
  const actionUrls = project.actions
    .filter((action) => action.href)
    .map((action) => absoluteUrl(action.href as string));
  const githubAction = project.actions.find(
    (action) => action.label.toLowerCase() === "github" && action.href,
  );

  return {
    "@type": details.type,
    "@id": `${canonicalUrl}#project-${project.id}`,
    name: project.title,
    alternateName: project.label,
    description: project.description.join(" "),
    url: `${canonicalUrl}#proyectos`,
    image: absoluteUrl(project.cartridge.src),
    inLanguage: "es",
    creator: {
      "@id": personId,
    },
    author: {
      "@id": personId,
    },
    isPartOf: {
      "@id": profileId,
    },
    creativeWorkStatus: project.status,
    keywords: project.stack,
    about: project.stack.map((technology) => ({
      "@type": "Thing",
      name: technology,
    })),
    ...(githubAction?.href ? { codeRepository: githubAction.href } : {}),
    ...(details.programmingLanguage
      ? { programmingLanguage: details.programmingLanguage }
      : {}),
    ...(details.runtimePlatform ? { runtimePlatform: details.runtimePlatform } : {}),
    ...(actionUrls.length > 0 ? { sameAs: actionUrls } : {}),
  };
});

const projectReferences = projectEntities.map((project) => ({
  "@id": project["@id"],
}));

const personData = {
  "@type": "Person",
  "@id": personId,
  name: "Pablo Ramos",
  url: canonicalUrl,
  image: socialImageUrl,
  jobTitle: "Desarrollador Fullstack",
  description,
  email: "mailto:contacto@pramos.dev",
  mainEntityOfPage: {
    "@id": profileId,
  },
  hasOccupation: {
    "@type": "Occupation",
    name: "Desarrollador Fullstack",
    description:
      "Desarrollador creativo con mentalidad fullstack especializado en frontend, backend, datos e inteligencia artificial.",
  },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "Contacto profesional",
    email: "contacto@pramos.dev",
    availableLanguage: ["es", "en"],
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Las Palmas",
    addressRegion: "Canarias",
    addressCountry: "ES",
  },
  knowsAbout: [
    "Frontend",
    "Backend",
    "Datos",
    "Inteligencia artificial",
    "RAG",
    "Tools / Function Calling",
    "Astro",
    "React",
    "TypeScript",
    "Phaser",
    "Tailwind CSS",
    "Python",
    "FastAPI",
    "PostgreSQL",
    "SQL",
    "Groq",
    "Qlik",
    "Power BI",
    "ETL",
    "Data Visualization",
  ],
  subjectOf: projectReferences,
  sameAs: ["https://github.com/lPable-Rm", "https://www.instagram.com/lpablo.ramos/"],
};

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: canonicalUrl,
      name: "Pablo Ramos Portfolio",
      description,
      author: {
        "@id": personId,
      },
      publisher: {
        "@id": personId,
      },
      about: {
        "@id": personId,
      },
      inLanguage: "es",
    },
    {
      "@type": "ProfilePage",
      "@id": profileId,
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: {
        "@id": websiteId,
      },
      about: {
        "@id": personId,
      },
      mainEntity: personData,
      hasPart: projectReferences,
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: socialImageUrl,
        caption: "Pablo Ramos, desarrollador fullstack en Las Palmas",
      },
      inLanguage: "es",
    },
    ...projectEntities,
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <!-- Metadatos basicos para que la pagina sea responsive, indexable y tenga favicon. -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <!-- URL principal que deben indexar los buscadores. -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Metadatos sociales: mejoran la vista previa al compartir la web. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pablo Ramos Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Pablo Ramos, desarrollador fullstack en Las Palmas" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Pablo Ramos, desarrollador fullstack en Las Palmas" />

    <!-- Datos estructurados: refuerzan la entidad Pablo Ramos para buscadores e IA. -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title}</title>
    <!-- Analitica invisible de Vercel: mide visitas sin modificar la interfaz. -->
    <Analytics />
  </head>
  <body>
    <!-- Enlace de accesibilidad: permite saltar el menu usando teclado. -->
    <a class="skip-link" href="#main-content">Saltar al contenido</a>

    <!-- Header React porque necesitara estado activo y menu movil. -->
    <Header client:load />

    <!-- Aqui Astro inyecta las secciones de cada pagina. -->
    <main id="main-content" class="site-main">
      <slot />
    </main>
  </body>
</html>
