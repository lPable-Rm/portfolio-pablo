<!-- Hero: primera impresion del portfolio y presentacion clara de Pablo. -->
<section class="section hero-section" id="hero" aria-labelledby="hero-title">
  <!-- Barra lateral decorativa del boceto. No transmite contenido, solo ambienta. -->
  <img
    class="hero-left-rail"
    src="/assets/sprites/image-removebg-preview.png"
    alt=""
    width="43"
    height="439"
    aria-hidden="true"
    decoding="async"
  />

  <div class="section-shell hero-grid">
    <!-- Bloque de texto principal. Mantiene el mensaje directo y legible. -->
    <div class="hero-copy">
      <h1 class="hero-title" id="hero-title">
        <span class="hero-title-line hero-title-line--cyan">Hola,</span>
        <span class="hero-title-line hero-title-line--magenta">
          soy Pablo <span class="hero-title-dot">.</span>
        </span>
      </h1>
      <p class="hero-subtitle">
        Desarrollador creativo con mentalidad <strong>fullstack</strong>.
      </p>
      <div class="hero-text">
        <p>
          No me gusta encerrarme en una sola etiqueta. Construyo proyectos
          completos combinando frontend, backend, datos e inteligencia
          artificial.
        </p>
        <p>
          Cuando una idea me motiva, aprendo lo necesario para hacerla realidad.
        </p>
      </div>
    </div>

    <!-- Avatar real del Hero. Vive en public/assets/sprites y se carga por URL publica. -->
    <div class="hero-visual">
      <!-- Pantalla arcade del boceto. Se coloca detras del avatar con CSS. -->
      <img
        class="hero-game-screen"
        src="/assets/backgrounds/IconoVideojuego.png"
        alt=""
        width="433"
        height="577"
        aria-hidden="true"
        decoding="async"
      />
      <img
        class="hero-avatar-image"
        src="/assets/sprites/AvatarPixelart-SInbg.png"
        alt="Pablo en estilo pixel art"
        width="512"
        height="512"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>
