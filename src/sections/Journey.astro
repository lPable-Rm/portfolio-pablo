---
// Componemos la seccion con una carcasa Astro y el montaje React de Phaser.
import GameConsole from "../components/game/GameConsole.astro";
import GameWrapper from "../components/game/GameWrapper";
---

<!-- Mi viaje: seccion reservada para el mini juego narrativo con Phaser. -->
<section class="section section--panel" id="viaje" aria-labelledby="journey-title">
  <div class="section-shell">
    <!-- Cabecera centrada con el mismo lenguaje arcade de Proyectos. -->
    <div class="section-heading journey-heading">
      <div class="journey-title-row">
        <span class="journey-heart" aria-hidden="true">&#9829;</span>
        <h2 class="section-title journey-title" id="journey-title">Mi viaje</h2>
        <span class="journey-heart" aria-hidden="true">&#9829;</span>
      </div>

      <div class="journey-subtitle-row">
        <span class="journey-subtitle-line" aria-hidden="true"></span>
        <p class="section-intro journey-subtitle">
          LEVEL 01 · TODO EMPEZÓ CON CURIOSIDAD
        </p>
        <span class="journey-subtitle-line" aria-hidden="true"></span>
      </div>
    </div>

    <!-- La carcasa recibe el componente React que crea el canvas de Phaser. -->
    <GameConsole>
      <GameWrapper client:only="react" />
    </GameConsole>
  </div>
</section>
